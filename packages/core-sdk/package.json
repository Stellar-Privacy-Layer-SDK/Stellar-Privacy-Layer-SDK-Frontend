{
  "name": "@stellar-privacy/sdk",
  "version": "0.1.0",
  "description": "Core SDK for Stellar Privacy Layer — abstracts Protocol 25 ZK primitives into simple functions",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@stellar/freighter-api": "^3.0.0",
    "@stellar/stellar-base": "^12.1.0",
    "@stellar/stellar-sdk": "^12.1.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
