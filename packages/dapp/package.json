{
  "name": "@stellar-privacy/dapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run build -w @stellar-privacy/sdk",
    "dev": "vite",
    "prebuild": "npm run build -w @stellar-privacy/sdk",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "pretypecheck": "npm run build -w @stellar-privacy/sdk",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @stellar-privacy/sdk",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build -w @stellar-privacy/sdk",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@stellar-privacy/sdk": "*",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
