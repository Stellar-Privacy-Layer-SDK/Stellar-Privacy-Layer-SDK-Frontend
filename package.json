{
  "name": "stellar-privacy-layer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "🔒 Stellar Privacy Layer — Confidential Transfers SDK",
  "workspaces": [
    "packages/core-sdk",
    "packages/dapp"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run build:sdk && npm run build:dapp",
    "build:sdk": "npm run build -w packages/core-sdk",
    "build:dapp": "npm run build -w packages/dapp",
    "dev": "npm run dev -w packages/dapp",
    "dev:sdk": "npm run dev -w packages/core-sdk",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:sdk": "npm run test -w packages/core-sdk",
    "test:dapp": "npm run test -w packages/dapp",
    "test:coverage": "npm run test:coverage --workspaces",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "clean": "npm run clean --workspaces",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "deploy": "bash scripts/deploy.sh up",
    "build:circuits": "node scripts/build-circuits.mjs",
    "build:contract": "cd packages/contract && cargo build --release --target wasm32v1-none",
    "test:e2e": "node scripts/e2e.mjs",
    "deploy:pool": "node scripts/deploy-pool.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "circom2": "0.2.22",
    "circomlib": "2.0.5",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "underscore": "^1.13.8"
  }
}
