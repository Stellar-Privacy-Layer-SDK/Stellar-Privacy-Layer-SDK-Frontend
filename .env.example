# Stellar Privacy Layer - Environment Configuration
# Copy this file to .env and fill in your values.

# Stellar Network Configuration
# Options: public, testnet, futurenet, sandbox
VITE_STELLAR_NETWORK=testnet

# Soroban RPC URL (overrides network default if set)
# Mainnet: https://soroban-rpc.stellar.org
# Testnet: https://soroban-rpc-testnet.stellar.org
VITE_SOROBAN_RPC_URL=

# Deployed Privacy Contract ID (required for on-chain operations)
# Example: CAQZ6Y2B7GJ6XK6Y2B7GJ6XK6Y2B7GJ6XK6Y2B7GJ6XK6Y2B7GJ6XK6
VITE_CONTRACT_ID=

# Horizon URL (overrides network default if set)
VITE_HORIZON_URL=

# Wallet Configuration
# Freighter is the default Stellar wallet
# Future: Add other wallet providers here

# Development
# Set to true to enable verbose logging
VITE_DEBUG=false
