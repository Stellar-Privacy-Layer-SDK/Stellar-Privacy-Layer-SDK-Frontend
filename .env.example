# Stellar Privacy Layer - Environment Configuration
# Copy this file to .env and fill in your values.

# Stellar Network Configuration
# Options: public, testnet, futurenet, sandbox
VITE_STELLAR_NETWORK=testnet

# Soroban RPC URL (overrides network default if set)
# Mainnet: https://mainnet.sorobanrpc.com
# Testnet: https://soroban-testnet.stellar.org
VITE_SOROBAN_RPC_URL=

# Shielded pool contract ID (required for on-chain operations)
# Example: CAQZ6Y2B7GJ6XK6Y2B7GJ6XK6Y2B7GJ6XK6Y2B7GJ6XK6Y2B7GJ6XK6
VITE_CONTRACT_ID=

# Horizon URL (overrides network default if set)
VITE_HORIZON_URL=

# ZK circuit artifacts 
# Base URL of hosted Groth16 artifacts generated by `npm run build:circuits`:
#   withdraw.wasm, withdraw_final.zkey, verification_key.json
# Required to withdraw. Must match the verification key of the deployed pool.
# Example: https://github.com/Stellar-Privacy-Layer-SDK/Stellar-Privacy-Layer-SDK-Frontend/releases/latest/download
VITE_ZK_ARTIFACTS_URL=

# Relayer (packages/relayer). Without it your own wallet submits withdrawals.
VITE_RELAYER_URL=

# Development
# Set to true to enable verbose logging
VITE_DEBUG=false
