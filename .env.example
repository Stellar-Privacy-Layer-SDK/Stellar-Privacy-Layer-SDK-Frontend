# Stellar Privacy Layer - Environment Configuration
# Copy this file to .env and fill in your values.

# Stellar Network Configuration
# Options: public, testnet, futurenet, sandbox
VITE_STELLAR_NETWORK=testnet

# Soroban RPC URL (overrides network default if set)
# Mainnet: https://soroban-rpc.stellar.org
# Testnet: https://soroban-rpc-testnet.stellar.org
VITE_SOROBAN_RPC_URL=

# Deployed Privacy Contract ID (required for on-chain operations)
# Example: CAQZ6Y2B7GJ6XK6Y2B7GJ6XK6Y2B7GJ6XK6Y2B7GJ6XK6Y2B7GJ6XK6
VITE_CONTRACT_ID=

# Horizon URL (overrides network default if set)
VITE_HORIZON_URL=

# ZK circuit artifacts (production prover)
# Base URL of hosted Groth16 artifacts generated by `npm run build:circuits`:
#   shielded_transfer.wasm, shielded_transfer_final.zkey, verification_key.json
# When unset, the dApp uses the dev-only SimulatedProver (no real ZK security).
# Example: https://github.com/Stellar-Privacy-Layer-SDK/Stellar-Privacy-Layer-SDK-Frontend/releases/latest/download
VITE_ZK_ARTIFACTS_URL=

# Token contract addresses for the dApp (JSON map of symbol -> contract ID).
# Only `native` (XLM) or valid C... contract IDs are shown in the UI; the
# selected token's contract address is what gets submitted on-chain.
VITE_TOKEN_CONTRACTS={"USDC":"CA..."}

# Wallet Configuration
# Freighter is the default Stellar wallet
# Future: Add other wallet providers here

# Development
# Set to true to enable verbose logging
VITE_DEBUG=false
